# ============================================
# Configuración del Frontend - ERP/POS YOMYOM
# ============================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Modificar REACT_APP_API_URL según tu entorno
# 3. NUNCA commitear el archivo .env al repositorio
#
# cp .env.example .env
#

# URL del backend API
# En desarrollo local: http://localhost:8000
# En producción: https://api.tudominio.com
REACT_APP_API_URL=http://localhost:8000

# URL de Metabase (BI / Analítica)
# En desarrollo local: http://localhost:3001
REACT_APP_METABASE_URL=http://localhost:3001

# UUIDs de dashboards públicos de Metabase
# Se generan al ejecutar: bash scripts/setup-metabase.sh
# El script los guarda en frontend/.env.metabase — copiar los valores aquí
# REACT_APP_METABASE_DASHBOARD_VENTAS=
# REACT_APP_METABASE_DASHBOARD_INVENTARIO=
# REACT_APP_METABASE_DASHBOARD_GENERAL=

# ============================================
# Notas
# ============================================
#
# - Las variables de entorno en React deben comenzar con REACT_APP_
# - Después de cambiar .env, reiniciar el servidor de desarrollo (npm start)
# - En producción, estas variables se inyectan en tiempo de build
#
